    "date-fns": "3.6.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "4.5.0",
    "ioredis": "5.4.1",
    "next": "^14.2.35",
    "node-fetch": "3.3.2",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rss-parser": "3.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.5.4"
  }
