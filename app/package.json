{
  "name": "threats-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "collect": "node dist/collector.js",
    "collect:rss": "tsx ../collector/collect-rss.ts",
    "collect:ioc": "tsx ../collector/collect-ioc.ts",
    "collect:cve": "tsx ../collector/collect-cve.ts 2>/dev/null || echo \"collect-cve yok (opsiyonel)\"",
