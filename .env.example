# threats.0rce.com — environment
# Kopyala: cp .env.example .env  → POSTGRES_PASSWORD değiştir

# PostgreSQL şifresi (zorunlu — güçlü bir değer ver)
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD

# Kritik olay webhook'u (Slack/Telegram) — boşsa alert sadece loglanır
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/... veya Telegram bot API URL
ALERT_WEBHOOK_URL=
